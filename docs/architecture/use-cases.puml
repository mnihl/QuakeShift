@startuml use-cases
!include style.iuml
!pragma layout smetana
left to right direction
skinparam ActorBorderColor #6B7280
skinparam ActorBackgroundColor #F3F4F6
skinparam UsecaseBackgroundColor #DBEAFE
skinparam UsecaseBorderColor #2563EB
skinparam UsecaseFontSize 12
skinparam RectangleBackgroundColor #FAFAFA

title QuakeShift – use cases

actor "User\n(duty seismologist)" as user
actor "Waveform source\n(GEOFON / replay)" as src
actor "Carbon signal" as carbon
actor "EMSC catalogue" as emsc

rectangle QuakeShift {
  usecase "Detect earthquakes\nin near real time" as UC1
  usecase "Browse earthquakes\nand dashboards" as UC2
  usecase "Switch processing\nprofile" as UC3 #DCFCE7;line:15803D
  usecase "Back-fill eco periods\nwith the big model" as UC4 #DCFCE7;line:15803D
  usecase "Evaluate detections\nagainst EMSC" as UC5 #DCFCE7;line:15803D
}

src -- UC1
user -- UC2
carbon -- UC3
carbon -- UC4
emsc -- UC5
user -- UC5

UC4 ..> UC1 : <<include>>
@enduml
