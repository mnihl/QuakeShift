@startuml use-cases
!include style.iuml
!pragma layout smetana
left to right direction
skinparam ActorBorderColor #6B7280
skinparam ActorBackgroundColor #F3F4F6
skinparam UsecaseBackgroundColor #DBEAFE
skinparam UsecaseBorderColor #2563EB
skinparam UsecaseFontSize 12
skinparam RectangleBackgroundColor #FAFAFA

title QuakeShift – use cases

actor "User\n(duty seismologist)" as user
actor "Waveform source\n(GEOFON / replay)" as src
actor "Carbon signal" as carbon
actor "EMSC catalogue" as emsc

rectangle QuakeShift {
  usecase "UC1 Detect earthquakes\nin near real time" as UC1
  usecase "UC2 Switch processing\nprofile" as UC2 #DCFCE7;line:15803D
  usecase "UC3 Back-fill eco periods\nwith the big model" as UC3 #DCFCE7;line:15803D
  usecase "UC4 Evaluate detections\nagainst EMSC" as UC4 #DCFCE7;line:15803D
  usecase "UC5 Browse earthquakes\nand dashboards" as UC5
}

src -- UC1
carbon -- UC2
carbon -- UC3
emsc -- UC4
user -- UC4
user -- UC5

UC3 ..> UC1 : <<include>>
@enduml
