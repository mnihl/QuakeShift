@startuml
skinparam shadowing false
skinparam defaultFontName Arial
title QuakeShift: live detection and resource-aware adaptation
participant "Live / replay\ningestor" as I
database "Archive +\nPostgreSQL" as D
queue RabbitMQ as Q
participant Picker as P
participant "Associator /\nresults API" as A
participant "Resource / carbon\ncontroller" as C
participant "Metrics / carbon\nproviders" as M
participant Kubernetes as K

I -> D : Store raw window + pending job
I -> Q : Publish waveform reference + policy version
Q -> P : Deliver live job
P -> D : Read waveform and pinned policy
alt Selected station; model runs (STA/LTA-gated in eco)
  P -> P : Preprocess; infer P/S arrivals
  P -> D : Persist picks + pending publication
  P -> Q : Publish picks
  Q -> A : Deliver picks
  A -> D : Associate by travel time/location; upsert event
  A -> Q : Acknowledge persisted result
else Eco skips station or trigger does not fire
  P -> D : Record deferred window
end
opt Any eco-period window, including processed windows
  P -> D : Retain for full-model review
end
P -> Q : Acknowledge completed job

group Periodic adaptation (independent of individual jobs)
  C -> M : Read carbon intensity, queue lag, resource usage
  C -> K : Read available capacity and rollout status
  C -> D : Save versioned mode/station policy
  opt Resource profile or replica count must change
    C -> K : Patch managed worker Deployment
    K -> P : Scale / rolling replacement; readiness checks
    C -> K : Check rollout; restore prior profile on failure
  end
end

opt Cleaner electricity + spare live capacity
  C -> D : Claim deferred windows
  C -> Q : Schedule background EQTransformer jobs
  Q -> P : Deliver background jobs
  ref over D,A
    Same inference and association path;
    revise existing events or add missed events.
  end ref
end
note over D,Q
  Recover pending publications after failures.
  Stable job IDs and idempotent writes make retries safe.
end note
@enduml
